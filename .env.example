# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Подходит любой OpenAI-совместимый API — меняются только три строки ниже.

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# OpenRouter (любая модель из каталога)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4.1-mini

# Локальная Ollama (ключ не нужен)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# Необязательные настройки
LLM_TEMPERATURE=0.2        # пусто = не передавать (нужно некоторым reasoning-моделям)
LLM_JSON_MODE=true         # просить у API ответ строго в JSON
LLM_TIMEOUT=90             # секунд на один запрос
MAX_REPAIR_ATTEMPTS=2      # сколько раз отправлять модели найденные проблемы на исправление
